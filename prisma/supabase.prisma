generator client {
 provider = "prisma-client-js"
 output = "../node_modules/@prumo/supabase-client"
}
datasource db {
 provider = "postgresql"
 url = env("SUPABASE_DATABASE_URL")
}
model Admin {
 id Int @id @default(1)
 email String @unique
 hash String
}
model Session {
 id String @id
 expires DateTime

 @@map("WorkspaceSession")
}
model Record {
 id String @id @default(cuid())
 kind String
 data String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Audit {
 id String @id @default(cuid())
 action String
 entityId String
 before String?
 after String?
 createdAt DateTime @default(now())
}
model ImportBatch {
 id String @id
 filename String
 createdAt DateTime @default(now())
}
