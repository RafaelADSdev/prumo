DATABASE_URL="file:./finance.db"

NEXT_TELEMETRY_DISABLED=1

# Supabase: credenciais somente do servidor; nunca use NEXT_PUBLIC_ para a chave secreta.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
# Conexão PostgreSQL (Session pooler) necessária para futura migração do Prisma.
SUPABASE_DATABASE_URL=""
