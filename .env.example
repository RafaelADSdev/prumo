DATABASE_URL="file:./finance.db"

NEXT_TELEMETRY_DISABLED=1

# Supabase: credenciais somente do servidor; nunca use NEXT_PUBLIC_ para a chave secreta.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
# Conexão PostgreSQL Session pooler. Use schema=prumo&sslmode=require&sslaccept=strict&sslcert=supabase-ca.crt.
# Execute npm run supabase:migrate para copiar o SQLite e ativar DATABASE_URL.
SUPABASE_DATABASE_URL=""

# IDs dos usuários do Supabase Auth autorizados a acessar este financeiro.
SUPABASE_PRUMO_USER_IDS=""
# ID do usuário Supabase que compartilha o espaço financeiro do administrador legado.
SUPABASE_PRUMO_PRIMARY_USER_ID=""

# Cofre do Assistente IA: 32 bytes aleatórios codificados em Base64. Somente no servidor.
PRUMO_AI_ENCRYPTION_KEY=""
